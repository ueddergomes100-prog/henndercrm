# Public project URL. Safe to expose only when paired with an anon key and RLS policies.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public browser credential from Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Server-only credential. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=replace-with-server-only-secret-key

# Change this value before deploying. Used to sign the HTTP-only CRM session cookie.
CRM_SESSION_SECRET=replace-with-a-long-random-secret

# Enable behind HTTPS in production.
CRM_COOKIE_SECURE=true

# Hennder Sync / Uniplus read-only PostgreSQL connection.
# Use these only in the local/VPS agent environment that can reach the Uniplus database.
UNIPLUS_DATABASE_URL=postgres://readonly-user:readonly-password@uniplus-host:5432/uniplus-db
UNIPLUS_SSL=false
UNIPLUS_SYNC_BATCH_SIZE=5000
UNIPLUS_SYNC_MODE=incremental
HENNDER_SYNC_LOG_DIR=.data/hennder-sync-logs

# Production login users are managed in Supabase Auth and linked in public.crm_usuarios.
# Do not deploy CRM_*_PASSWORD variables for production login.
